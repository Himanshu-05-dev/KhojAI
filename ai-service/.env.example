PORT=8000
HOST=0.0.0.0
SERVICE_SECRET=internal-secret

# LLM Configuration
# Options: 'nvidia', 'openai', 'gemini', 'mock'
LLM_PROVIDER=nvidia

# NVIDIA NIM / Build API (Free Tier with High-Parameter Models)
# Base URL: https://integrate.api.nvidia.com/v1
# Free models: 'meta/llama-3.3-70b-instruct', 'meta/llama-3.1-405b-instruct', 'nvidia/llama-3.1-nemotron-70b-instruct', 'deepseek-ai/deepseek-r1'
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Other Providers (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=

ENVIRONMENT=development
