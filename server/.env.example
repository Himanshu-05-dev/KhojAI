# KhojAI Backend Environment Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/khojai
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-here-at-least-32-chars
JWT_EXPIRY=7d
SALT_ROUNDS=12

# AI Orchestration Microservice
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=internal-secret

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Push & Email Notifications (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@khojai.dev
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KhojAI <no-reply@khojai.dev>

# Development Mode
DEMO_MODE=true
