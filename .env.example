# ================================================================
# KhojAI - Global Environment Reference
# Copy the relevant sections to client/.env, server/.env, and ai-service/.env
# ================================================================

# --- CLIENT (client/.env) ---
PORT=5173
VITE_API_URL=/api/v1
VITE_BACKEND_URL=http://localhost:5000

# --- BACKEND SERVER (server/.env) ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/khojai
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-secure-jwt-secret-here-at-least-32-chars
JWT_EXPIRY=7d
SALT_ROUNDS=12
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=internal-secret
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
DEMO_MODE=true

# Notification Integrations (Optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@khojai.dev
EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KhojAI <no-reply@khojai.dev>

# --- AI MICROSERVICE (ai-service/.env) ---
PORT=8000
HOST=0.0.0.0
SERVICE_SECRET=internal-secret
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
ENVIRONMENT=development
